# Default output folder of fingerprint_extract.py / ridge
fingerprints/

# Finger photos and extracted prints are biometric data: keep them out of git.
# (The bracket patterns also match upper-case extensions such as .JPG and .HEIC.)
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
# Fingerprint interchange formats (WSQ images, ANSI/NIST-ITL transactions)
*.[wW][sS][qQ]
*.[nN][iI][sS][tT]
*.[aA][nN]2
*.[eE][fF][tT]

# Claude Code local state (agent worktrees)
.claude/
# Derived biometric data in JSON (minutiae) and exported job reports (personal data)
*_minutiae.json
*_report.json

# Desktop GUI build output and generated files (icons are drawn by tools/gui_icons.py)
gui/node_modules/
gui/dist/
gui/coverage/
gui/src-tauri/target/
gui/src-tauri/gen/
gui/src-tauri/icons/
gui/src-tauri/permissions/autogenerated/
gui/src-tauri/sbom-cargo.json
