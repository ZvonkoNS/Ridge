{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: Ridge commands only. No fs, shell, http, dialog or other plugin permission.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-choose-store",
    "allow-refresh-store",
    "allow-create-identity",
    "allow-create-case",
    "allow-unlock-case",
    "allow-lock-case",
    "allow-session-status",
    "allow-case-info",
    "allow-set-legal-hold",
    "allow-list-items",
    "allow-import-evidence",
    "allow-import-reference",
    "allow-verify-case",
    "allow-export-item",
    "allow-preview",
    "allow-preview-region",
    "allow-run-job",
    "allow-list-jobs",
    "allow-get-report",
    "allow-export-report",
    "allow-reproduce-job",
    "allow-export-log",
    "allow-export-comparison",
    "allow-get-minutiae",
    "allow-limits-of-use",
    "allow-export-head"
  ]
}
