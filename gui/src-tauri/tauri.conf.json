{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ridge",
  "version": "0.2.0",
  "identifier": "si.nextsight.ridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main", "passphrase"],
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi", "nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "category": "Utility",
    "shortDescription": "Forensic fingerprint image-enhancement aid",
    "longDescription": "Ridge extracts ridge detail from photos of fingers for manual comparison by a qualified examiner. It does not identify anyone."
  }
}
